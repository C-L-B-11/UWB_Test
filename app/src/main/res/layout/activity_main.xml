<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.UWB_Test.AppBarOverlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/Theme.UWB_Test.PopupOverlay"
                app:title="UWB_Test" />
        </com.google.android.material.appbar.AppBarLayout>


        <TextView
            android:id="@+id/tvIsController"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="IsController"
            android:textSize="10pt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bar" />


        <Switch
            android:id="@+id/swIsController"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvIsController"
            app:layout_constraintStart_toEndOf="@+id/tvIsController"
            app:layout_constraintTop_toTopOf="@+id/tvIsController" />


        <TextView
            android:id="@+id/tvMakeLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="Make Log"
            android:textSize="10pt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvIsController" />


        <Switch
            android:id="@+id/swMakeLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvMakeLog"
            app:layout_constraintStart_toEndOf="@+id/tvMakeLog"
            app:layout_constraintTop_toTopOf="@+id/tvMakeLog" />



        <Button
            android:id="@+id/ConButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="10dp"
            android:text="Connect"
            app:layout_constraintEnd_toStartOf="@+id/DConButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMakeLog" />

        <Button
            android:id="@+id/DConButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"

            android:layout_marginEnd="10dp"
            android:text="Disconnect"
            android:enabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ConButton"
            app:layout_constraintTop_toTopOf="@+id/ConButton"
            app:layout_constraintBottom_toBottomOf="@+id/ConButton"/>
        <Button
            android:id="@+id/StartMsgBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="0dp"
            android:text="Start Measuring"
            android:enabled="false"
            app:layout_constraintEnd_toEndOf="@+id/ConButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ConButton" />

        <Button
            android:id="@+id/StopMsgBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="0dp"

            android:layout_marginEnd="10dp"
            android:text="Stop Measuring"
            android:enabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/DConButton"
            app:layout_constraintTop_toTopOf="@+id/StartMsgBtn"
            app:layout_constraintBottom_toBottomOf="@+id/StartMsgBtn"/>

        <TextView
            android:id="@+id/rangeDisplay"
            android:layout_width="wrap_content"
            android:layout_height="78dp"
            android:layout_marginTop="10dp"
            android:text="10cm"
            android:textSize="50sp"
            app:layout_anchorGravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/exception" />

        <TextView
            android:id="@+id/exception"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="TextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/StartMsgBtn" />


    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>